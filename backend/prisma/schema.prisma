// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS - Status and Type Definitions
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  SALES
  INVENTORY
  PROCUREMENT
  FINANCE
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  LOST
  CONVERTED
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  PARTIAL
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIAL_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StockMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  TRANSFER
  DAMAGE
  RETURN
}

enum StockMovementDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  DIGITAL_WALLET
  UPI
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  SUPPLIES
  UTILITIES
  RENT
  SALARIES
  MAINTENANCE
  ADVERTISING
  OTHER
}

// ============================================
// SAAS / CORE MODELS
// ============================================

model Organization {
  id            String   @id @default(cuid())
  name          String   @unique
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  industry      String?
  employeeCount Int?
  website       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  users                  User[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  deals                  Deal[]
  activities             Activity[]
  products               Product[]
  warehouses             Warehouse[]
  stock                  Stock[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  quotations             Quotation[]
  salesOrders            SalesOrder[]
  invoices               Invoice[]
  payments               Payment[]
  expenses               Expense[]
  accounts               Account[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String   // Will be hashed in Phase 2
  role           UserRole @default(VIEWER)
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

// ============================================
// CRM MODELS
// ============================================

model Company {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  industry         String?
  employeeCount    Int?
  revenue          Decimal? @db.Decimal(15, 2)
  website          String?
  ownerName        String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  leads            Lead[]
  deals            Deal[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  invoices         Invoice[]

  @@index([organizationId])
  @@map("companies")
}

model Contact {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  title            String?
  department       String?
  companyId        String
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads            Lead[]
  deals            Deal[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contacts")
}

model Lead {
  id               String      @id @default(cuid())
  title            String
  email            String?
  phone            String?
  status           LeadStatus  @default(NEW)
  companyId        String?
  contactId        String?
  organizationId   String
  source           String?
  budget           Decimal?    @db.Decimal(15, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@map("leads")
}

model Deal {
  id               String      @id @default(cuid())
  title            String
  value            Decimal     @db.Decimal(15, 2)
  probability      Int         @default(50) // 0-100
  stage            DealStage   @default(DISCOVERY)
  expectedCloseDate DateTime?
  companyId        String
  contactId        String?
  organizationId   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  activities       Activity[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([stage])
  @@map("deals")
}

model Activity {
  id               String   @id @default(cuid())
  title            String
  description      String?
  type             String   @default("CALL") // CALL, EMAIL, MEETING, NOTE
  dueDate          DateTime?
  completedDate    DateTime?
  dealId           String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal             Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dealId])
  @@map("activities")
}

// ============================================
// SALES MODELS
// ============================================

model Quotation {
  id               String              @id @default(cuid())
  code             String              @unique @default(cuid())
  companyId        String
  contactId        String?
  dealId           String?
  status           QuotationStatus     @default(DRAFT)
  subtotal         Decimal             @db.Decimal(15, 2)
  tax              Decimal             @db.Decimal(15, 2) @default(0)
  total            Decimal             @db.Decimal(15, 2)
  expiryDate       DateTime?
  organizationId   String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relationships
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  salesOrders      SalesOrder[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id               String   @id @default(cuid())
  quotationId      String
  productId        String
  quantity         Decimal  @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineTotal        Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model SalesOrder {
  id               String              @id @default(cuid())
  code             String              @unique @default(cuid())
  companyId        String
  contactId        String?
  dealId           String?
  quotationId      String?
  status           SalesOrderStatus    @default(DRAFT)
  subtotal         Decimal             @db.Decimal(15, 2)
  tax              Decimal             @db.Decimal(15, 2) @default(0)
  total            Decimal             @db.Decimal(15, 2)
  orderDate        DateTime            @default(now())
  dueDate          DateTime?
  organizationId   String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relationships
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact          Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  quotation        Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items            SalesOrderItem[]
  stockMovements   StockMovement[]
  invoices         Invoice[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([quotationId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String   @id @default(cuid())
  salesOrderId     String
  productId        String
  quantity         Decimal  @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineTotal        Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

// ============================================
// INVENTORY MODELS
// ============================================

model Product {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  description      String?
  status           ProductStatus   @default(ACTIVE)
  cost             Decimal         @db.Decimal(15, 2)
  sellingPrice     Decimal         @db.Decimal(15, 2)
  unit             String          @default("PCS") // PCS, KG, LTR, etc
  organizationId   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock            Stock[]
  stockMovements   StockMovement[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  invoiceItems     InvoiceItem[]

  @@index([organizationId])
  @@index([status])
  @@map("products")
}

model Warehouse {
  id               String   @id @default(cuid())
  name             String
  location         String?
  address          String?
  city             String?
  state            String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stock            Stock[]
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]

  @@index([organizationId])
  @@map("warehouses")
}

model Stock {
  id               String   @id @default(cuid())
  productId        String
  warehouseId      String
  quantity         Decimal  @db.Decimal(12, 2) @default(0)
  reservedQuantity Decimal  @db.Decimal(12, 2) @default(0)
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Unique constraint to prevent duplicate stock records
  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
}

model StockMovement {
  id               String                   @id @default(cuid())
  productId        String
  warehouseId      String
  type             StockMovementType
  direction        StockMovementDirection
  quantity         Decimal                  @db.Decimal(12, 2)
  reference        String?                  // Code of related document (SO, PO, GR)
  salesOrderId     String?
  purchaseOrderId  String?
  goodsReceiptId   String?
  organizationId   String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // Relationships
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOrder       SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([direction])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================
// PROCUREMENT MODELS
// ============================================

model Supplier {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  contactPerson    String?
  paymentTerms     String?
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  expenses         Expense[]

  @@index([organizationId])
  @@map("suppliers")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  code             String              @unique @default(cuid())
  supplierId       String
  warehouseId      String
  status           PurchaseOrderStatus @default(DRAFT)
  subtotal         Decimal             @db.Decimal(15, 2)
  tax              Decimal             @db.Decimal(15, 2) @default(0)
  total            Decimal             @db.Decimal(15, 2)
  orderDate        DateTime            @default(now())
  expectedDelivery DateTime?
  organizationId   String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relationships
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  stockMovements   StockMovement[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal  @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineTotal        Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String               @id @default(cuid())
  code             String               @unique @default(cuid())
  purchaseOrderId  String
  warehouseId      String
  status           GoodsReceiptStatus   @default(DRAFT)
  receivedDate     DateTime             @default(now())
  organizationId   String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relationships
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items            GoodsReceiptItem[]
  stockMovements   StockMovement[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String   @id @default(cuid())
  goodsReceiptId   String
  productId        String
  receivedQuantity Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

// ============================================
// FINANCE MODELS
// ============================================

model Invoice {
  id               String          @id @default(cuid())
  code             String          @unique @default(cuid())
  companyId        String
  salesOrderId     String?
  status           InvoiceStatus   @default(DRAFT)
  subtotal         Decimal         @db.Decimal(15, 2)
  tax              Decimal         @db.Decimal(15, 2) @default(0)
  total            Decimal         @db.Decimal(15, 2)
  paidAmount       Decimal         @db.Decimal(15, 2) @default(0)
  outstandingAmount Decimal        @db.Decimal(15, 2)
  issueDate        DateTime        @default(now())
  dueDate          DateTime?
  organizationId   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relationships
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]

  @@index([organizationId])
  @@index([companyId])
  @@index([salesOrderId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id               String   @id @default(cuid())
  invoiceId        String
  productId        String
  quantity         Decimal  @db.Decimal(12, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineTotal        Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id               String         @id @default(cuid())
  invoiceId        String
  amount           Decimal        @db.Decimal(15, 2)
  method           PaymentMethod  @default(BANK_TRANSFER)
  transactionRef   String?        // UTR, cheque number, etc
  paymentDate      DateTime       @default(now())
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id               String            @id @default(cuid())
  category         ExpenseCategory   @default(OTHER)
  amount           Decimal           @db.Decimal(15, 2)
  description      String?
  supplierId       String?
  expenseDate      DateTime          @default(now())
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([supplierId])
  @@index([category])
  @@map("expenses")
}

model Account {
  id               String       @id @default(cuid())
  name             String
  accountType      AccountType
  balance          Decimal      @db.Decimal(15, 2) @default(0)
  description      String?
  organizationId   String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([accountType])
  @@map("accounts")
}
